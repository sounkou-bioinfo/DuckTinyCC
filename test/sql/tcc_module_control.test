);
----
false	codegen_preview	E_BAD_WRAPPER_MODE

query TTT
SELECT ok, mode, code
FROM tcc_module(
  mode := 'codegen_preview',
  symbol := 'add2',
  sql_name := 'add2_preview_bad_stability',
  return_type := 'i64',
  arg_types := ['i64'],
  stability := 'weird'
);
----
false	codegen_preview	E_BAD_STABILITY

query I
SELECT CASE WHEN detail LIKE '%"volatile"%' THEN 1 ELSE 0 END
FROM tcc_module(
  mode := 'codegen_preview',
  symbol := 'vol_preview',
  sql_name := 'vol_preview',
  return_type := 'i64',
  arg_types := [],
  stability := 'volatile'
);
----
1

query TTT
SELECT ok, mode, code
FROM tcc_module(
  mode := 'quick_compile',
  source := 'int add_i32(int a, int b){ return a + b; }',
  symbol := 'add_i32',
  sql_name := 'add_i32',
  return_type := 'i32',
  arg_types := ['i32', 'i32']
);
----
true	quick_compile	OK

query I
SELECT add_i32(20, 22);
----
42

query TTT
SELECT ok, mode, code
FROM tcc_module(
  mode := 'quick_compile',
  source := 'int add_i32(int a, int b){ return a + b + 1; }',
  symbol := 'add_i32',
  sql_name := 'add_i32',
  return_type := 'i32',
  arg_types := ['i32', 'i32']
);
----
false	quick_compile	E_INIT_FAILED

query I
SELECT add_i32(20, 22);
----
42

query TTT
SELECT ok, mode, code
FROM tcc_module(
  mode := 'quick_compile',
  source := 'long long vol_counter(void){ static long long x=0; return ++x; }',
  symbol := 'vol_counter',
  sql_name := 'vol_counter',
  return_type := 'i64',
  arg_types := [],
  stability := 'volatile'
);
----
true	quick_compile	OK

query T
WITH vals AS (SELECT i, vol_counter() AS v FROM range(3) t(i))
SELECT string_agg(v::VARCHAR, ',' ORDER BY i) FROM vals;
----
1,2,3

query TTT
SELECT ok, mode, code
FROM tcc_module(
  mode := 'quick_compile',
  source := 'long long consistent_counter(void){ static long long x=0; return ++x; }',
  symbol := 'consistent_counter',
  sql_name := 'consistent_counter',
  return_type := 'i64',
  arg_types := []
);
----
true	quick_compile	OK

query T
WITH vals AS (SELECT i, consistent_counter() AS v FROM range(3) t(i))
SELECT string_agg(v::VARCHAR, ',' ORDER BY i) FROM vals;
----
1,1,1

query TTT
SELECT ok, mode, code
FROM tcc_module(
  mode := 'quick_compile',
  source := '#include <math.h>
double qpow(double x, double y){ return pow(x, y); }',
  symbol := 'qpow',
  sql_name := 'qpow',
  return_type := 'f64',
  arg_types := ['f64', 'f64'],
  include_path := 'third_party/tinycc/include',
  library_path := 'third_party/tinycc',
  library := 'm'
);
----
true	quick_compile	OK

query I
SELECT CAST(qpow(2.0, 5.0) AS BIGINT);
----
32

query TTT
SELECT ok, mode, code
FROM tcc_module(
  mode := 'quick_compile',
  source := '_Bool gt0(long long x){ return x > 0; }',
  symbol := 'gt0',
  sql_name := 'gt0',
  return_type := 'bool',
  arg_types := ['i64']
);
----
true	quick_compile	OK

query TT
SELECT gt0(3), gt0(-1);
----
true	false

