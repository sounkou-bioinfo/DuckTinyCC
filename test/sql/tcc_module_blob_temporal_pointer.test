# name: test/sql/tcc_module_blob_temporal_pointer.test
# description: BLOB, temporal, decimal, pointer, and raw-memory bridge coverage
# group: [ducktinycc]

require ducktinycc

query TTT
SELECT ok, mode, code
FROM tcc_module(
  mode := 'quick_compile',
  source := 'unsigned long long blob_len(ducktinycc_blob_t b){ return b.ptr ? b.len : 0ULL; }',
  symbol := 'blob_len',
  sql_name := 'blob_len',
  return_type := 'u64',
  arg_types := ['blob']
);
----
true	quick_compile	OK

query I
SELECT CAST(blob_len(from_hex('DEADBEEF')) AS BIGINT);
----
4

query T
SELECT blob_len(NULL);
----
NULL

query TTT
SELECT ok, mode, code
FROM tcc_module(
  mode := 'quick_compile',
  source := 'ducktinycc_blob_t blob_echo(ducktinycc_blob_t b){ return b; }',
  symbol := 'blob_echo',
  sql_name := 'blob_echo',
  return_type := 'blob',
  arg_types := ['blob']
);
----
true	quick_compile	OK

query T
SELECT hex(blob_echo(from_hex('00FF10')));
----
00FF10

query T
SELECT blob_echo(NULL);
----
NULL

query TTT
SELECT ok, mode, code
FROM tcc_module(
  mode := 'quick_compile',
  source := 'ducktinycc_blob_t make_empty_blob(void){
  ducktinycc_blob_t out;
  out.ptr = (const void *)0;
  out.len = 0;
  return out;
}',
  symbol := 'make_empty_blob',
  sql_name := 'make_empty_blob',
  return_type := 'blob',
  arg_types := []
);
----
true	quick_compile	OK

query TI
SELECT make_empty_blob() IS NULL, octet_length(make_empty_blob())::BIGINT;
----
false	0

query TTT
SELECT ok, mode, code
FROM tcc_module(
  mode := 'quick_compile',
  source := 'ducktinycc_blob_t batch_blob_echo(ducktinycc_blob_t b){ return b; }',
  symbol := 'batch_blob_echo',
  sql_name := 'batch_blob_echo',
  return_type := 'blob',
  arg_types := ['blob'],
  wrapper_mode := 'chunk_scalar_loop'
);
----
true	quick_compile	OK

query TT
SELECT hex(batch_blob_echo(from_hex('ABCD'))), batch_blob_echo(NULL) IS NULL;
----
ABCD	true

query TTT
SELECT ok, mode, code
FROM tcc_module(
  mode := 'quick_compile',
  source := 'long long blob_read_i32(ducktinycc_blob_t b){
  int32_t v = 0;
  if (!b.ptr) return 0;
  if (!ducktinycc_read_i32(b.ptr, b.len, 0, &v)) return -1;
  return (long long)v;
}',
  symbol := 'blob_read_i32',
  sql_name := 'blob_read_i32',
  return_type := 'i64',
  arg_types := ['blob']
);
----
true	quick_compile	OK

query I
SELECT blob_read_i32(from_hex('2A000000'));
----
42

query I
SELECT blob_read_i32(from_hex('2A0000'));
----
-1

query TTT
SELECT ok, mode, code
FROM tcc_module(
  mode := 'quick_compile',
  source := 'long long local_rw_i64(void){
  uint8_t buf[16];
  int64_t out = 0;
  if (!ducktinycc_write_i64(buf, sizeof(buf), 8, 41)) return -1;
  if (!ducktinycc_read_i64(buf, sizeof(buf), 8, &out)) return -2;
  return out + 1;
}',
  symbol := 'local_rw_i64',
  sql_name := 'local_rw_i64',
  return_type := 'i64',
  arg_types := []
);
----
true	quick_compile	OK

query I
SELECT local_rw_i64();
----
42

